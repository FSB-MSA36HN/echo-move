# Copy to .env (export before running). All optional.
ECHO_HOST=0.0.0.0
ECHO_PORT=8000
ECHO_MODEL=yolov8n-pose.pt
ECHO_DEMO_MODE=0          # 1 = skip YOLO, stream synthetic scenarios
ECHO_PIQE_MODE=both       # fast | full | both
ECHO_PIQE_SAMPLE_N=30
ECHO_SERVER_FPS=20
ECHO_MAX_PERSONS=5
ECHO_MATLAB_DIR=./output
ECHO_CORS_ORIGINS=*       # comma-separated; restrict in production
ECHO_LOG_LEVEL=INFO

# --- Server-side cameras (empty = none). name=source, comma-separated.
# Source: RTSP/HTTP URL, USB index (0, 1...) or a video file path (loops).
# ECHO_CAMERAS=kho=rtsp://user:pass@192.168.1.10:554/stream1,cong=0
# ECHO_CAMERAS_FILE=./cameras.json   # {"kho": "rtsp://...", "cong": 0}
ECHO_CAMERA_FPS=10        # frames analysed per second per camera

# --- Alert confirmation (seconds)
ECHO_FALL_CONFIRM_S=1.5
ECHO_POSTURE_CONFIRM_S=3
ECHO_QUALITY_CONFIRM_S=5
ECHO_ALERT_COOLDOWN_S=30

ECHO_FALL_MULTISIGNAL=1   # 0 = v21 rule (trunk tilt + wide box only)
ECHO_MANDOWN_S=10         # still on the floor this long after a FALL → MANDOWN
ECHO_ERGO_REBA=6          # REBA score counted as risky posture
ECHO_ERGO_EXPOSURE_S=60   # risky-posture seconds within 10 min → ERGO
ECHO_OFFLINE_ALERT_S=30   # camera down this long → OFFLINE (0 = off)

# --- PPE (optional YOLO detection model with helmet / vest classes; empty = off)
# ECHO_PPE_MODEL=./models/ppe.pt
ECHO_PPE_REQUIRED=helmet,vest
ECHO_PPE_CONFIRM_S=5

# --- Event log (SQLite echo.db + snapshots/ + clips/)
ECHO_DATA_DIR=./output
ECHO_RECORD_BROWSER_EVENTS=1
ECHO_EVENT_CLIPS=1        # record 5 s before + 5 s after each camera event
ECHO_BLUR_FACES=1         # pixelate heads in stored snapshots / clips
ECHO_RETENTION_DAYS=0     # delete events older than N days (0 = keep forever)

# --- Notifications (leave empty to disable)
ECHO_TELEGRAM_TOKEN=
ECHO_TELEGRAM_CHAT_ID=
ECHO_WEBHOOK_URL=
ECHO_ZALO_OA_TOKEN=
ECHO_ZALO_USER_ID=
ECHO_ESCALATE_MIN=0       # resend unacknowledged CRITICAL events after N minutes (0 = off)
ECHO_ESCALATE_TELEGRAM_CHAT_ID=   # supervisor chat for escalations (default: main chat)

# --- Web UI served at / (auto-detected; set if the folder lives elsewhere)
# ECHO_WEB_DIR=./web
